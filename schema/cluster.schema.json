{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://logika.rbdsailab.com/schema/cluster.schema.json",
  "title": "Design-AI Literacy Taxonomy — Cluster",
  "type": "object",
  "required": ["subject", "band", "ageRangeStart", "ageRangeEnd", "name", "topicIds", "summary"],
  "properties": {
    "subject": { "enum": ["Foundations", "Generative Mechanics", "The Brief", "Judgment", "Ethics & Provenance", "Studio Practice"] },
    "band": { "enum": ["on-ramp", "foundation", "studio"] },
    "ageRangeStart": { "type": "integer", "minimum": 11, "maximum": 22 },
    "ageRangeEnd": { "type": "integer", "minimum": 11, "maximum": 22 },
    "name": { "type": "string", "minLength": 1, "maxLength": 60 },
    "topicIds": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^dt_[a-z0-9-]+$" } },
    "summary": { "type": "string", "minLength": 50, "description": "Faculty-facing one-paragraph summary" }
  }
}
